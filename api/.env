APP_NAME=Our Blue Planet Earth
APP_VERSION=4.0.0

# SQLite development database
DATABASE_URL=sqlite+aiosqlite:///./planetary_health.db

# PostgreSQL production database example:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/planetary

GEMINI_API_KEY=
GEMINI_MODEL=

OPENAQ_API_KEY=

API_ACCESS_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

CORS_ORIGINS=http://localhost:3000,http://localhost:8501

REQUEST_TIMEOUT=30
MAX_REQUESTS_PER_MINUTE=60

PREDICTION_MINIMUM_RECORDS=30
